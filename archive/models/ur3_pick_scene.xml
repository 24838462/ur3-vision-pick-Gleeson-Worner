<mujoco model="ur3_pick_scene">

  <include file="ur3_collision_fixed.xml"/>

  <visual>
    <global offwidth="640" offheight="480"/>
  </visual>

  <worldbody>
    <light name="scene_light"
           pos="0.3 -0.3 1.5"
           dir="0 0 -1"
           directional="true"/>

    <geom name="floor"
          type="plane"
          pos="0 0 -0.75"
          size="2 2 0.1"
          rgba="0.25 0.25 0.28 1"
          contype="1" conaffinity="1"/>

    <!-- Box sizes are half-dimensions, in metres. -->
    <geom name="table_top"
          type="box"
          pos="0.25 0 -0.04"
          size="0.55 0.45 0.03"
          rgba="0.65 0.58 0.45 1"
          contype="1" conaffinity="1"/>

    <!-- Fixed 4 cm cube for the first camera test. -->
    <body name="target_cube" pos="0.30 0.10 0.01">
      <geom name="target_cube_geom"
            type="box"
            size="0.02 0.02 0.02"
            rgba="0.9 0.1 0.1 1"
            contype="1" conaffinity="1"/>
    </body>
  </worldbody>

</mujoco>